[
    {
        "id": "rankCustomSqlQA",
        "type": "CUSTOM_SQL",
        "customSql": "with base AS (SELECT ${TIME_COLUMN}, ${GROUPBY_COLUMN}, ${KPI_COLUMN}, DENSE_RANK() OVER (PARTITION BY ${TIME_QUERY} ORDER BY ${KPI_FORMULA} ${SORT_DIRECTION}) AS rank FROM ${TABLE_NAME} left join (SELECT NULLIF(COUNT(issue_key), 0) as Total_Test FROM omniq.qa_test_created) qat ON 1 = 1 WHERE ${startTime_clause} AND ${endTime_clause} ${FILTER_PLACEHOLDER} GROUP BY ${TIME_COLUMN_ALIAS}, ${GROUPBY_ID}) SELECT ${TIME_COLUMN_ALIAS}, ${KPI_ID}, ${GROUPBY_ID} from base WHERE rank <= ${rank_value} order by ${TIME_COLUMN_ALIAS};"
    },
