    {
        "id": "kpiQAReporting",
        "type": "KPI",
        "name": "KPI",
        "queryMapping": [
            {
                "id": "${KPI_ID}",
                "name": "${KPI_NAME}",
                "runSql": "${KPI_FORMULA}",
                "select": "${KPI_COLUMN}",
                "extraConfig": "palette,timeInterval,defaultTime"
            }
        ],
        "customSql": "Select ${TIME_COLUMN}, ${GROUPBY_COLUMN}, ${KPI_COLUMN} from ${TABLE_NAME} left join (SELECT NULLIF(COUNT(issue_key), 0) as Total_Test FROM omniq.qa_test_created) qat ON 1 = 1 where ${startTime_clause} AND ${endTime_clause} ${FILTER_PLACEHOLDER} Group by ${TIME_COLUMN_ALIAS}, ${GROUPBY_ID} Order By ${TIME_COLUMN_ALIAS}",
        "data": [
            {
                "id": "qaTotalAutomatedTests",
                "name": "Total Automated Tests",
                "runSql": "COUNT(DISTINCT EXECUTED_TEST)"
            },
            {
                "id": "qaPassedTests",
                "name": "Passed Tests",
                "runSql": "COUNT(DISTINCT CASE WHEN UPPER(AUTO_TEST_RUN_STATUS) = 'PASS' THEN EXECUTED_TEST END)"
            },
            {
                "id": "qaExecutionSuccessRatePct",
                "name": "Execution Success Rate %",
                "runSql": "ROUND(100.0 * COUNT(DISTINCT CASE WHEN UPPER(AUTO_TEST_RUN_STATUS) = 'PASS' THEN EXECUTED_TEST END) / NULLIF(COUNT(DISTINCT EXECUTED_TEST), 0), 2)",
                "valueSuffix": "%"
            },
            {
                "id": "qaTotalScenarios",
                "name": "Total Scenarios",
                "runSql": "SUM(TOTAL_SCENARIOS)"
            },
            {
                "id": "qaAutomationCoveragePct",
                "name": "Automation Coverage %",
                "runSql": "ROUND(100.0 * COUNT(DISTINCT EXECUTED_TEST) / NULLIF((SELECT COUNT(qat.\"Issue key\") FROM omniq.qa_test_created qat), 0), 2)",
                "valueSuffix": "%"
            },
            {
                "id": "qaPassedScenarios",
                "name": "Passed Scenarios",
                "runSql": "SUM(PASSED_SCENARIOS)"
            },
            {
                "id": "qaFailedScenarios",
                "name": "Failed Scenarios",
                "runSql": "SUM(FAILED_SCENARIOS)"
            },
            {
                "id": "qaAutomationStabilityPct",
                "name": "Automation Stability %",
                "runSql": "ROUND(100.0 * SUM(PASSED_SCENARIOS) / NULLIF(SUM(PASSED_SCENARIOS) + SUM(FAILED_SCENARIOS), 0), 2)",
                "valueSuffix": "%"
            },
            {
                "id": "qaBugsDetectedByAutomation",
                "name": "Bugs Detected By Automation",
                "runSql": "COUNT(DISTINCT CASE WHEN QA_REPORT = 'Automation' THEN BUGS END)"
            },
            {
                "id": "qaTotalBugsDetected",
                "name": "Total Bugs Detected",
                "runSql": "COUNT(DISTINCT BUGS)"
            },
            {
                "id": "qaOpenBugsPerSprint",
                "name": "Open Bugs Per Sprint",
                "runSql": "AVG(OPEN_BUGS)"
            },
            {
                "id": "qaClosedBugsPerSprint",
                "name": "Closed Bugs Per Sprint",
                "runSql": "AVG(CLOSED_BUGS)"
            },
            {
                "id": "qaOpenBugRatePct",
                "name": "Open Bug Rate %",
                "runSql": "ROUND(100.0 * AVG(COALESCE(OPEN_BUGS, 0)) / NULLIF(AVG(COALESCE(OPEN_BUGS, 0)) + AVG(COALESCE(CLOSED_BUGS, 0)), 0), 2)",
                "valueSuffix": "%"
            },
            {
                "id": "qaBugsPer100Tests",
                "name": "Bugs Per 100 Tests",
                "runSql": "ROUND(COUNT(DISTINCT CASE WHEN QA_REPORT = 'Automation' THEN BUGS END) * 100.0 / NULLIF(COUNT(DISTINCT EXECUTED_TEST), 0), 2)"
            },
            {
                "id": "qaAvgResolutionDays",
                "name": "Avg Resolution Days",
                "runSql": "ROUND(AVG(RESOLUTION_DAYS), 2)"
            },
            {
                "id": "qaAvgExecutionDurationMin",
                "name": "Avg Execution Duration Min",
                "runSql": "ROUND(AVG(TOTAL_EXECUTION_DURATION_MIN), 2)"
            },
            {
                "id": "qaTotalExecutionDurationMin",
                "name": "Total Execution Duration Min",
                "runSql": "SUM(TOTAL_EXECUTION_DURATION_MIN)"
            },
            {
                "id": "qaExecutiveQualityScore",
                "name": "Executive Quality Score",
                "runSql": "ROUND(((ROUND(100.0 * COUNT(DISTINCT CASE WHEN UPPER(AUTO_TEST_RUN_STATUS) = 'PASS' THEN EXECUTED_TEST END) / NULLIF(COUNT(DISTINCT EXECUTED_TEST), 0), 2)) * 0.40 + (100 - (100.0 * SUM(COALESCE(OPEN_BUGS, 0)) / NULLIF(SUM(COALESCE(OPEN_BUGS, 0)) + SUM(COALESCE(CLOSED_BUGS, 0)), 0))) * 0.40 + (CASE WHEN AVG(RESOLUTION_DAYS) >= 100 THEN 0 ELSE 100 - AVG(RESOLUTION_DAYS) END) * 0.20), 2)"
            },
            {
                "id": "qaTotalBugs",
                "name": "Total Bugs",
                "runSql": "SUM(TOTAL_BUGS)"
            },
            {
                "id": "qaRegressionBugs",
                "name": "Regression Bugs",
                "runSql": "SUM(REGRESSION_BUGS)"
            },
            {
                "id": "qaCriticalRegressionBugs",
                "name": "Critical Regression Bugs",
                "runSql": "SUM(CRITICAL_REGRESSION_BUGS)"
            },
            {
                "id": "qaOpenRegressionBugs",
                "name": "Open Regression Bugs",
                "runSql": "SUM(OPEN_REGRESSION_BUGS)"
            },
            {
                "id": "qaClosedRegressionBugs",
                "name": "Closed Regression Bugs",
                "runSql": "SUM(CLOSED_REGRESSION_BUGS)"
            },
            {
                "id": "qaCustomerRegressionBugs",
                "name": "Customer Regression Bugs",
                "runSql": "SUM(CUSTOMER_REGRESSION_BUGS)"
            },
            {
                "id": "qaAvgRegressionResolutionDays",
                "name": "Avg Regression Resolution Days",
                "runSql": "AVG(CASE WHEN BUG_CATEGORY = 'Regression' THEN RESOLUTION_DAYS END)"
            },
            {
                "id": "qaBlockerMTTR",
                "name": "Blocker MTTR",
                "runSql": "AVG(CASE WHEN BUG_CATEGORY = 'Regression' AND PRIORITY = 'Blocker' THEN RESOLUTION_DAYS END)"
            },
            {
                "id": "qaTotalReleases",
                "name": "Total Releases",
                "runSql": "COUNT(DISTINCT CASE WHEN COALESCE(FIX_VERSIONS, '') <> '' THEN FIX_VERSIONS END)"
            },
            {
                "id": "qaFailedReleases",
                "name": "Failed Releases",
                "runSql": "COUNT(DISTINCT CASE WHEN COALESCE(FIX_VERSIONS, '') <> '' AND BUG_CATEGORY = 'Regression' THEN FIX_VERSIONS END)"
            },
            {
                "id": "qaDeploymentsPerMonth",
                "name": "Deployments Per Month",
                "runSql": "COUNT(DISTINCT CASE WHEN COALESCE(FIX_VERSIONS, '') <> '' THEN FIX_VERSIONS END)::numeric / NULLIF(COUNT(DISTINCT CASE WHEN COALESCE(FIX_VERSIONS, '') <> '' THEN DATE_TRUNC('month', BUG_RESOLVED) END), 0)"
            },
            {
                "id": "qaCompletedSprints",
                "name": "Completed Sprints",
                "runSql": "COUNT(DISTINCT CASE WHEN SPRINT_STATUS = 'Completed' THEN SPRINT END)"
            }
        ],
        "tableMapping": [
            {
                "table": "omniq.AGG_QA_REPORT_5_MIN",
                "minIntervalInHours": ">0"
            },
            {
                "table": "omniq.AGG_QA_REPORT_HOUR",
                "minIntervalInHours": ">2"
            },
            {
                "table": "omniq.AGG_QA_REPORT_DAY",
                "minIntervalInHours": ">=24"
            }
        ],
        "kpiDetails": [
            {
                "_id": "trend",
                "type": "TREND"
            },
            {
                "_id": "rank",
                "type": "RANK",
                "customSql": "rankCustomSqlQA"
            }
        ]
    },
