{
  "jira": {
    "base_url": "https://jira-prod.radcom.co.il:8443",
    "api_version": "2",
    "auth_type": "bearer",
    "pat_env": "JIRA_PAT",
    "email_env": "JIRA_EMAIL",
    "token_env": "JIRA_API_TOKEN",
    "verify_ssl": false,
    "timeout_seconds": 60
  },
  "output_dir": "Report CSV",
  "reports": [
    {
      "key": "automation_job",
      "name": "Automation Job",
      "jql": "type = \"Auto Process\" AND \"Job Name\" in (\"BE Tester - BI\",BI_Sanity, \"BE Tester - ADP\", \"BE Tester - NAM\", \"BE Tester - PAM\", \"BE Tester - SAM\", \"NAM_Regression\", \"NAM_Sanity\", \"PAM_Sanity\",\"PAM_Regression\", \"SAM_Regression\", \"SAM_Sanity\") AND \"Automation Test Run Approved\" = Yes AND  created >= 2026-01-01 ORDER BY created ASC",
      "filename_template": "Automation Job {year} {timestamp}.csv",
      "page_size": 100,
      "max_results": 5000,
      "columns": [
        {
          "csv": "Issue Type",
          "path": "fields.issuetype",
          "default": ""
        },
        {
          "csv": "Issue key",
          "path": "key",
          "default": ""
        },
        {
          "csv": "Description",
          "path": "fields.description",
          "default": ""
        },
        {
          "csv": "Created",
          "path": "fields.created",
          "default": ""
        },
        {
          "csv": "Updated",
          "path": "fields.updated",
          "default": ""
        },
        {
